# 이 파일은 커밋된다. 실제 값은 Vercel Project Environment Variables 또는 .env.local에 둔다.
# 모든 키는 production / preview / development 3환경에서 분리 관리한다.

# --- Supabase (서버 only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (클라이언트 노출 OK · RLS로 보호) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site URL (OG/Twitter metadataBase) ---
# production에서 실제 도메인으로 등록. 미설정 시 layout.tsx의 default 사용.
NEXT_PUBLIC_SITE_URL=

# --- Cloudflare Turnstile (봇 방어) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Upstash Redis (rate limit) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
